{
  "name": "easytrim-editor",
  "private": true,
  "version": "1.11.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm changelog:prepare && node scripts/dev.mjs",
    "build": "pnpm changelog:prepare && pnpm --filter @easytrim-editor/desktop tauri build --no-bundle",
    "build:web": "pnpm changelog:prepare && pnpm --filter @easytrim-editor/desktop build",
    "preview": "node scripts/preview-production.mjs",
    "preview:web": "pnpm --filter @easytrim-editor/desktop preview",
    "storybook": "pnpm changelog:prepare && pnpm --filter @easytrim-editor/desktop storybook",
    "build:storybook": "pnpm changelog:prepare && pnpm --filter @easytrim-editor/desktop build:storybook",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 && pnpm i18n:check",
    "lint:fix": "eslint . --fix --max-warnings 0 && prettier --write .",
    "lint-format": "pnpm format && pnpm lint:fix",
    "i18n:check": "node scripts/validate-i18n.mjs",
    "knip": "knip --production",
    "typecheck": "pnpm changelog:prepare && pnpm --filter @easytrim-editor/desktop typecheck",
    "typecheck:storybook": "pnpm changelog:prepare && pnpm --filter @easytrim-editor/desktop typecheck:storybook",
    "test": "pnpm changelog:prepare && pnpm --filter @easytrim-editor/desktop test",
    "test:release": "node --test scripts/__tests__/*.test.mjs",
    "icons:generate": "node scripts/generate-desktop-icons.mjs",
    "icons:prepare-macos": "node scripts/prepare-macos-icon.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "changelog:generate": "node scripts/generate-changelog.mjs",
    "changelog:prepare": "node scripts/generate-changelog.mjs",
    "release:local": "pnpm changelog:prepare && node scripts/release-local.mjs",
    "release:linux": "node scripts/release-linux-docker.mjs",
    "check": "pnpm changelog:prepare && pnpm format:check && pnpm lint && pnpm knip && pnpm --filter @easytrim-editor/desktop typecheck && pnpm --filter @easytrim-editor/desktop typecheck:storybook && pnpm --filter @easytrim-editor/desktop test && pnpm test:release && pnpm --filter @easytrim-editor/desktop build:storybook && pnpm --filter @easytrim-editor/desktop build",
    "tauri": "pnpm --filter @easytrim-editor/desktop tauri"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "globals": "17.8.0",
    "knip": "6.32.3",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
