{
  "name": "easytrim-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @easytrim-editor/desktop tauri build --no-bundle",
    "build:web": "pnpm --filter @easytrim-editor/desktop build",
    "preview": "node scripts/preview-production.mjs",
    "preview:web": "pnpm --filter @easytrim-editor/desktop preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm --filter @easytrim-editor/desktop typecheck",
    "test": "pnpm --filter @easytrim-editor/desktop test",
    "release:local": "node scripts/release-local.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build:web",
    "tauri": "pnpm --filter @easytrim-editor/desktop tauri"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "typescript-eslint": "8.65.0"
  }
}
