{
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "printWidth": 100,
  "proseWrap": "preserve",
  "quoteProps": "as-needed",
  "semi": true,
  "singleQuote": false,
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindFunctions": ["cn", "cva", "clsx", "twMerge"],
  "tailwindStylesheet": "./apps/desktop/src/styles/globals.css",
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  "overrides": [
    {
      "files": "packages/ui/**",
      "options": {
        "tailwindStylesheet": "./packages/ui/src/styles/globals.css"
      }
    },
    {
      "files": "apps/desktop/src/i18n/locales/*.ts",
      "options": {
        "printWidth": 10000
      }
    }
  ]
}
