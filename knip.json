{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/dev.mjs!",
        "scripts/preview-production.mjs!",
        "scripts/generate-desktop-icons.mjs!",
        "scripts/prepare-macos-icon.mjs!",
        "scripts/bump-version.mjs!",
        "scripts/generate-changelog.mjs!",
        "scripts/generate-i18n-coverage.mjs!",
        "scripts/validate-i18n.mjs!",
        "scripts/release-local.mjs!",
        "scripts/release-linux-docker.mjs!",
        "scripts/check-ui-pixel-units.mjs!"
      ],
      "project": ["scripts/**/*.mjs!"],
      "ignore": ["scripts/**/__tests__/**"]
    },
    "apps/desktop": {
      "entry": [
        "src/main.tsx!",
        "src/i18n/resources.ts!",
        "src/domain/workspace-history.ts!",
        "src/app/store/integration/workspace-history.ts!"
      ],
      "project": ["src/**/*.ts!", "src/**/*.tsx!"],
      "ignoreDependencies": ["@fontsource/inter", "shadcn"],
      "ignore": [
        "src/components/**",
        "src/test/**",
        "src/**/__stories__/**",
        "src/**/__tests__/**",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/**/*.spec.ts",
        "src/**/*.spec.tsx"
      ]
    },
    "packages/ui": {
      "ignoreDependencies": ["shadcn", "tailwindcss", "tw-animate-css"],
      "project": ["src/**/*.ts!", "src/**/*.tsx!"],
      "ignore": ["src/test/**", "src/**/__stories__/**", "src/**/__tests__/**"]
    }
  }
}
